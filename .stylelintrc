{
  "extends": ["stylelint-config-carbon"],
  "rules": {
    "max-nesting-depth": 2,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ]
  },
  # The v12 lane: styles imported from the source kit (tools/v12-import).
  # Property order and the empty-line rules stay on: `stylelint --fix` applies
  # them, and the import tool runs it. Off, here only, is what no fixer can
  # apply without changing the CSS or the kit's structure:
  #   length-zero-no-unit        0px is kept where a unit is needed (calc, @property)
  #   selector-not-notation      :not(a):not(b) to :not(a, b) changes specificity
  #   no-duplicate-selectors     the kit repeats a theme scope, in cascade order
  #   no-descending-specificity  a fix would reorder the cascade
  #   a11y/media-prefers-reduced-motion
  #                              its fixer wraps rules in a broken media block; the
  #                              kit handles reduced motion in its tokens and tests
  # rule-empty-line-before also ignores a rule after a comment, so the fixer
  # does not detach a comment from the rule it describes.
  "overrides": [
    {
      "files": [
        "packages/react/src/v12/components/**/*.scss",
        "packages/v12-styles/**/*.scss"
      ],
      "rules": {
        "rule-empty-line-before": [
          "always",
          {
            "except": ["after-single-line-comment", "first-nested"],
            "ignore": ["after-comment"]
          }
        ],
        "length-zero-no-unit": null,
        "selector-not-notation": null,
        "no-duplicate-selectors": null,
        "no-descending-specificity": null,
        "a11y/media-prefers-reduced-motion": null
      }
    },
    # The model's style rules, as warnings until the components move onto it.
    # In a component stylesheet:
    #   a radius is a corners variable or inner(), never a literal length
    #   a page layer is Carbon's z(), never a fixed z-index (100 and up)
    #   a fill is a kit surface property or a contextual token, never a
    #   numbered layer token ($layer-01), which does not step inside a Layer
    #   no selector names a theme: the theme scopes are set in v12-styles
    {
      "files": ["packages/react/src/v12/components/**/*.scss"],
      "rules": {
        "declaration-property-value-disallowed-list": [
          {
            "/^(border(-[a-z]+)*-radius|--[\\w-]*radius)$/": [
              "/^(?!.*inner\\().*(^|[\\s(,])-?\\d*\\.?\\d*[1-9]\\d*(px|r?em|%)/"
            ],
            "z-index": ["/^-?\\d{3,}$/"],
            "/.*/": ["/(\\$|--cds-)layer(-[a-z]+)*-0[1-3]\\b/"]
          },
          {
            "severity": "warning",
            "message": "Off the model: \"%s: %s\". Use a corners variable or inner() for a radius, z() for a page layer, a kit surface or contextual token for a fill"
          }
        ],
        "selector-disallowed-list": [
          [
            "/\\[data-carbon-theme/",
            "/\\.cds--(white|g10|g90|g100)\\b/",
            "/\\.v12-(light|dark)\\b/"
          ],
          {
            "severity": "warning",
            "message": "Off the model: \"%s\" names a theme. Read a theme's values from the properties v12-styles sets on its scope"
          }
        ]
      }
    }
  ]
}
