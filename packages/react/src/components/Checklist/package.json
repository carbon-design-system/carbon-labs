{
  "name": "@carbon-labs/react-checklist",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "description": "Carbon Labs - Checklist",
  "labs": {
    "status": "draft",
    "title": "React Checklist"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-labs",
    "directory": "src/components/Checklist"
  },
  "types": "./es/index.d.ts",
  "exports": {
    ".": {
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./es/*": "./es/*",
    "./lib/*": "./lib/*",
    "./scss/*": "./scss/*"
  },
  "files": [
    "es",
    "lib",
    "scss",
    "telemetry.yml"
  ],
  "scripts": {
    "build": "node ../../../tasks/build.js",
    "clean": "rimraf es lib scss",
    "postinstall": "ibmtelemetry --config=telemetry.yml",
    "telemetry:config": "npx -y @ibm/telemetry-js-config-generator generate --id d47b6cda-7418-4b2d-8bc3-a283caf6e871 --endpoint https://www-api.ibm.com/ibm-telemetry/v1/metrics --files ./components/**/*.(tsx|js|jsx)"
  },
  "devDependencies": {
    "@carbon-labs/utilities": "0.28.0",
    "@carbon/colors": "^11.0.0"
  },
  "dependencies": {
    "@ibm/telemetry-js": "^1.10.2"
  },
  "peerDependencies": {
    "@carbon/colors": ">=11"
  }
}
