{
  "extends": "typescript-config-carbon/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "preserveSymlinks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/__stories__/*.stories.tsx",
    "**/__tests__/*",
    "**/__fixtures__/*",
    "vitest.config.ts",
    "**/*.d.ts",
    "node_modules",
    "dist"
  ]
}
