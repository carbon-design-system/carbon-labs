  },
  "dependencies": {
    "@carbon-labs/react-props": "workspace:*",
    "@carbon-labs/react-selection-kit": "workspace:*",
    "@carbon-labs/react-tooltip": "workspace:*",
    "@carbon-labs/react-util": "workspace:*",
    "@carbon-labs/v12-motion": "workspace:*",
    "@ibm/telemetry-js": "^1.10.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@carbon-labs/utilities": "0.28.0"
  }
