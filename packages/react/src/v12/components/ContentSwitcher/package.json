{
  "name": "@carbon-labs/react-content-switcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Carbon Labs - ContentSwitcher for React (v12)",
  "labs": {
    "status": "draft",
    "title": "V12 content switcher"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-labs",
    "directory": "packages/react/src/v12/components/ContentSwitcher"
  },
  "types": "./es/index.d.ts",
  "exports": {
