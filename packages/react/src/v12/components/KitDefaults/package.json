{
  "name": "@carbon-labs/react-kit-defaults",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Carbon Labs - KitDefaults for React (v12)",
  "labs": {
    "status": "draft",
    "title": "V12 kit defaults"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-labs",
    "directory": "packages/react/src/v12/components/KitDefaults"
  },
  "types": "./es/index.d.ts",
  "exports": {
    ".": {
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./es/*": "./es/*",
    "./lib/*": "./lib/*",
    "./scss/*": "./scss/*"
  },
  "files": [
    "es",
    "lib",
    "scss",
    "telemetry.yml"
  ],
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "scripts": {
    "build": "node ../../../../tasks/build.js",
    "clean": "rimraf es lib scss"
  },
  "dependencies": {
    "@carbon-labs/v12-motion": "workspace:*",
    "@carbon-labs/v12-styles": "workspace:*",
    "@ibm/telemetry-js": "^1.10.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@carbon-labs/utilities": "0.28.0"
  }
}
