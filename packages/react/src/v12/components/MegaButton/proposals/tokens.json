{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Token proposals for MegaButton (carbon-labs v12). Moves to packages/themes at graduation. Colour values are OKLCH (ADR 0011 in the IBM design harness): `carbon.themes` holds the per-theme value, `com.ibm.harness.curve` the colour family and lightness rule it was derived from, and `com.ibm.harness.fallback` the pinned sRGB hex for non-P3 displays.",
  "mega-button": {
    "primary-hover": {
      "$type": "color",
      "$description": "Primary fill on hover: blue responds to the person acting. Primary rests neutral (the primary-rest exploration).",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.454 0.2742 262.72)",
          "g10": "oklch(0.454 0.2742 262.72)",
          "g90": "oklch(0.5565 0.2605 261.96)",
          "g100": "oklch(0.5565 0.2605 261.96)"
        },
        "com.ibm.harness.fallback": {
          "white": "#0043CF",
          "g10": "#0043CF",
          "g90": "#0F62FE",
          "g100": "#0F62FE"
        },
        "com.ibm.harness.curve": {
          "family": "brand",
          "lightness": {
            "light": {
              "from": "brand",
              "delta": -0.1025
            },
            "dark": {
              "from": "brand",
              "delta": 0
            }
          },
          "status": "proposal",
          "token": "button-primary-hover"
        }
      }
    },
    "primary-active": {
      "$type": "color",
      "$description": "Primary fill while pressed: one step darker on the brand curve than hover, so the white label never flips.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.3626 0.2222 262.87)",
          "g10": "oklch(0.3626 0.2222 262.87)",
          "g90": "oklch(0.4651 0.2791 262.65)",
          "g100": "oklch(0.4651 0.2791 262.65)"
        },
        "com.ibm.harness.fallback": {
          "white": "#002E9A",
          "g10": "#002E9A",
          "g90": "#0046D5",
          "g100": "#0046D5"
        },
        "com.ibm.harness.curve": {
          "family": "brand",
          "lightness": {
            "from": "button-primary-hover",
            "delta": -0.0914
          },
          "status": "proposal",
          "token": "button-primary-active"
        }
      }
    },
    "primary-selected": {
      "$type": "color",
      "$description": "Primary fill when selected (aria-pressed): a selected primary stays blue.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.454 0.2742 262.72)",
          "g10": "oklch(0.454 0.2742 262.72)",
          "g90": "oklch(0.5565 0.2605 261.96)",
          "g100": "oklch(0.5565 0.2605 261.96)"
        },
        "com.ibm.harness.fallback": {
          "white": "#0043CF",
          "g10": "#0043CF",
          "g90": "#0F62FE",
          "g100": "#0F62FE"
        },
        "com.ibm.harness.curve": {
          "family": "brand",
          "lightness": {
            "from": "button-primary-hover",
            "delta": 0
          },
          "status": "proposal",
          "token": "button-primary-selected"
        }
      }
    },
    "key-command-rest": {
      "$type": "color",
      "$description": "Key-command hint on the resting primary fill: muted, and held to 4.5:1 because it is text.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.6243 0.008 262)",
          "g10": "oklch(0.6243 0.008 262)",
          "g90": "oklch(0.5211 0.008 262)",
          "g100": "oklch(0.5211 0.008 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#85888C",
          "g10": "#85888C",
          "g90": "#67696E",
          "g100": "#67696E"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray-quiet",
          "lightness": {
            "light": {
              "solve": {
                "on": "#1E1F21",
                "ratio": 4.6
              }
            },
            "dark": {
              "solve": {
                "on": "#EAEBEE",
                "ratio": 4.6
              }
            }
          },
          "status": "proposal",
          "token": "button-key-command-rest"
        }
      }
    },
    "key-command-hover": {
      "$type": "color",
      "$description": "Key-command hint on the primary hover and selected fill.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.8301 0.0351 260.22)",
          "g10": "oklch(0.8301 0.0351 260.22)",
          "g90": "oklch(1 0 253.9)",
          "g100": "oklch(1 0 253.9)"
        },
        "com.ibm.harness.fallback": {
          "white": "#BCC8DD",
          "g10": "#BCC8DD",
          "g90": "#FFFFFF",
          "g100": "#FFFFFF"
        },
        "com.ibm.harness.curve": {
          "family": "brand-muted",
          "lightness": {
            "light": {
              "solve": {
                "on": "button-primary-hover",
                "ratio": 4.6
              }
            },
            "dark": 1
          },
          "status": "proposal",
          "token": "button-key-command-hover"
        }
      }
    },
    "key-command-active": {
      "$type": "color",
      "$description": "Key-command hint on the pressed primary fill.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.723 0.0592 260.8)",
          "g10": "oklch(0.723 0.0592 260.8)",
          "g90": "oklch(0.8437 0.0322 260.02)",
          "g100": "oklch(0.8437 0.0322 260.02)"
        },
        "com.ibm.harness.fallback": {
          "white": "#92A7C9",
          "g10": "#92A7C9",
          "g90": "#C1CDDF",
          "g100": "#C1CDDF"
        },
        "com.ibm.harness.curve": {
          "family": "brand-muted",
          "lightness": {
            "solve": {
              "on": "button-primary-active",
              "ratio": 4.6
            }
          },
          "status": "proposal",
          "token": "button-key-command-active"
        }
      }
    },
    "key-command-neutral": {
      "$type": "color",
      "$description": "Key-command hint on transparent and tinted kinds (secondary, tertiary, ghost, danger secondary at rest), solved on the darkest tint it meets.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.4542 0.008 262)",
          "g10": "oklch(0.4542 0.008 262)",
          "g90": "oklch(0.7335 0.008 262)",
          "g100": "oklch(0.7335 0.008 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#54565B",
          "g10": "#54565B",
          "g90": "#A6A9AE",
          "g100": "#A6A9AE"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray-quiet",
          "lightness": {
            "solve": {
              "on": "button-tonal-active",
              "ratio": 4.6
            }
          },
          "status": "proposal",
          "token": "button-key-command-neutral"
        }
      }
    },
    "tonal-rest": {
      "$type": "color",
      "$description": "Tertiary (tonal) fill at rest; also ghost hover and secondary press.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.94 0.016 262)",
          "g10": "oklch(0.94 0.016 262)",
          "g90": "oklch(0.24 0.016 262)",
          "g100": "oklch(0.24 0.016 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#E5EBF6",
          "g10": "#E5EBF6",
          "g90": "#1B1F27",
          "g100": "#1B1F27"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray",
          "lightness": {
            "from": "surface",
            "state": "hover"
          },
          "status": "proposal",
          "token": "button-tonal-rest"
        }
      }
    },
    "tonal-hover": {
      "$type": "color",
      "$description": "Tertiary fill on hover; also ghost press. The hover state, one lightness step from rest.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.91 0.016 262)",
          "g10": "oklch(0.91 0.016 262)",
          "g90": "oklch(0.28 0.016 262)",
          "g100": "oklch(0.28 0.016 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#DCE2EC",
          "g10": "#DCE2EC",
          "g90": "#252931",
          "g100": "#252931"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray",
          "lightness": {
            "from": "button-tonal-rest",
            "state": "hover"
          },
          "status": "proposal",
          "token": "button-tonal-hover"
        }
      }
    },
    "tonal-active": {
      "$type": "color",
      "$description": "Tertiary fill while pressed: the active state, three lightness steps from its rest.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.85 0.016 262)",
          "g10": "oklch(0.85 0.016 262)",
          "g90": "oklch(0.36 0.016 262)",
          "g100": "oklch(0.36 0.016 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#C8CED9",
          "g10": "#C8CED9",
          "g90": "#393D46",
          "g100": "#393D46"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray",
          "lightness": {
            "from": "button-tonal-rest",
            "state": "active"
          },
          "status": "proposal",
          "token": "button-tonal-active"
        }
      }
    },
    "tonal-text-disabled": {
      "$type": "color",
      "$description": "Label of a disabled tertiary button, on its own resting fill.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.856 0.016 262)",
          "g10": "oklch(0.856 0.016 262)",
          "g90": "oklch(0.4 0.016 262)",
          "g100": "oklch(0.4 0.016 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#CAD0DB",
          "g10": "#CAD0DB",
          "g90": "#434851",
          "g100": "#434851"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray",
          "lightness": {
            "light": 0.856,
            "dark": 0.4
          },
          "status": "proposal",
          "token": "button-tonal-text-disabled"
        }
      }
    },
    "disabled-fill": {
      "$type": "color",
      "$description": "Fill of a disabled primary or danger button.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.84 0.016 262)",
          "g10": "oklch(0.84 0.016 262)",
          "g90": "oklch(0.24 0.016 262)",
          "g100": "oklch(0.24 0.016 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#C5CBD5",
          "g10": "#C5CBD5",
          "g90": "#1B1F27",
          "g100": "#1B1F27"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray",
          "lightness": {
            "light": 0.84,
            "dark": 0.24
          },
          "status": "proposal",
          "token": "button-disabled-fill"
        }
      }
    },
    "disabled-text": {
      "$type": "color",
      "$description": "Label of a disabled primary or danger button, on disabled-fill.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.69 0.016 262)",
          "g10": "oklch(0.69 0.016 262)",
          "g90": "oklch(0.4 0.016 262)",
          "g100": "oklch(0.4 0.016 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#969CA6",
          "g10": "#969CA6",
          "g90": "#434851",
          "g100": "#434851"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray",
          "lightness": {
            "light": 0.69,
            "dark": 0.4
          },
          "status": "proposal",
          "token": "button-disabled-text"
        }
      }
    },
    "interactive-text": {
      "$type": "color",
      "$description": "Blue label and border on a neutral ground when the person acts: secondary, tertiary and ghost on hover and press.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.454 0.2742 262.72)",
          "g10": "oklch(0.454 0.2742 262.72)",
          "g90": "oklch(0.7361 0.148 260.76)",
          "g100": "oklch(0.7361 0.148 260.76)"
        },
        "com.ibm.harness.fallback": {
          "white": "#0043CF",
          "g10": "#0043CF",
          "g90": "#77A9FF",
          "g100": "#77A9FF"
        },
        "com.ibm.harness.curve": {
          "family": "brand",
          "lightness": {
            "light": {
              "from": "brand",
              "delta": -0.1025
            },
            "dark": {
              "solve": {
                "on": "button-tonal-active",
                "ratio": 4.6
              }
            }
          },
          "status": "proposal",
          "token": "button-interactive-text"
        }
      }
    },
    "selected-fill": {
      "$type": "color",
      "$description": "Selected tint for secondary, tertiary and ghost (aria-pressed): the v12 blue-gray at the surface's selected step. The blue is in the label and border.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.91 0.016 262)",
          "g10": "oklch(0.91 0.016 262)",
          "g90": "oklch(0.28 0.016 262)",
          "g100": "oklch(0.28 0.016 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#DCE2EC",
          "g10": "#DCE2EC",
          "g90": "#252931",
          "g100": "#252931"
        },
        "com.ibm.harness.curve": {
          "family": "blue-gray",
          "lightness": {
            "from": "surface",
            "state": "selected"
          },
          "status": "proposal",
          "token": "button-selected-fill"
        }
      }
    },
    "selected-text": {
      "$type": "color",
      "$description": "Label and border on selected-fill, solved to 4.5:1 on it.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.5151 0.2884 262.26)",
          "g10": "oklch(0.5151 0.2884 262.26)",
          "g90": "oklch(0.6611 0.1942 261.16)",
          "g100": "oklch(0.6611 0.1942 261.16)"
        },
        "com.ibm.harness.fallback": {
          "white": "#0154EE",
          "g10": "#0154EE",
          "g90": "#4F8EFF",
          "g100": "#4F8EFF"
        },
        "com.ibm.harness.curve": {
          "family": "brand",
          "lightness": {
            "solve": {
              "on": "button-selected-fill",
              "ratio": 4.6
            }
          },
          "status": "proposal",
          "token": "button-selected-text"
        }
      }
    },
    "outline-border": {
      "$type": "color",
      "$description": "The 1px border of a resting secondary (outline) button.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.281 0.004 262)",
          "g10": "oklch(0.281 0.004 262)",
          "g90": "oklch(0.94 0.004 262)",
          "g100": "oklch(0.94 0.004 262)"
        },
        "com.ibm.harness.fallback": {
          "white": "#28292B",
          "g10": "#28292B",
          "g90": "#EAEBEE",
          "g100": "#EAEBEE"
        },
        "com.ibm.harness.curve": {
          "family": "cool-gray",
          "lightness": {
            "light": 0.281,
            "dark": 0.94
          },
          "status": "proposal",
          "token": "button-outline-border"
        }
      }
    },
    "danger-text": {
      "$type": "color",
      "$description": "Label of a danger secondary button at rest and in focus, solved to 4.5:1 on every surface.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.5519 0.2385 25.9)",
          "g10": "oklch(0.5519 0.2385 25.9)",
          "g90": "oklch(0.7538 0.1667 18.08)",
          "g100": "oklch(0.7538 0.1667 18.08)"
        },
        "com.ibm.harness.fallback": {
          "white": "#D11B26",
          "g10": "#D11B26",
          "g90": "#F68B90",
          "g100": "#F68B90"
        },
        "com.ibm.harness.curve": {
          "family": "danger",
          "lightness": {
            "light": {
              "solve": {
                "on": "light-content-sunken",
                "ratio": 4.5
              }
            },
            "dark": {
              "solve": {
                "on": "dark-ground-lightest",
                "ratio": 4.6
              }
            }
          },
          "status": "proposal",
          "token": "button-danger-text"
        }
      }
    },
    "danger-key-command-hover": {
      "$type": "color",
      "$description": "Key-command hint on the danger hover fill.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.8829 0.0309 15.02)",
          "g10": "oklch(0.8829 0.0309 15.02)",
          "g90": "oklch(0.8829 0.0309 15.02)",
          "g100": "oklch(0.8829 0.0309 15.02)"
        },
        "com.ibm.harness.fallback": {
          "white": "#E8D3D3",
          "g10": "#E8D3D3",
          "g90": "#E8D3D3",
          "g100": "#E8D3D3"
        },
        "com.ibm.harness.curve": {
          "family": "danger-muted",
          "lightness": {
            "solve": {
              "on": "danger-hover",
              "ratio": 4.6
            }
          },
          "status": "proposal",
          "token": "button-danger-key-command-hover"
        }
      }
    },
    "danger-key-command-active": {
      "$type": "color",
      "$description": "Key-command hint on the danger active fill.",
      "$extensions": {
        "carbon.themes": {
          "white": "oklch(0.7242 0.0695 19.57)",
          "g10": "oklch(0.7242 0.0695 19.57)",
          "g90": "oklch(0.7242 0.0695 19.57)",
          "g100": "oklch(0.7242 0.0695 19.57)"
        },
        "com.ibm.harness.fallback": {
          "white": "#C69998",
          "g10": "#C69998",
          "g90": "#C69998",
          "g100": "#C69998"
        },
        "com.ibm.harness.curve": {
          "family": "danger-muted",
          "lightness": {
            "solve": {
              "on": "danger-active",
              "ratio": 4.6
            }
          },
          "status": "proposal",
          "token": "button-danger-key-command-active"
        }
      }
    },
    "padding-inline-md": {
      "$type": "dimension",
      "$description": "Inline padding of a 40px (md) MegaButton. Padding grows with size (12/16/20/24px for xs–lg); md's 20px is the one step Carbon's spacing scale lacks.",
      "$extensions": {
        "carbon.themes": {
          "white": "1.25rem",
          "g10": "1.25rem",
          "g90": "1.25rem",
          "g100": "1.25rem"
        }
      }
    }
  }
}
