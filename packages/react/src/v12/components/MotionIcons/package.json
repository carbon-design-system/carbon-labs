{
  "name": "@carbon-labs/react-motion-icons",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Carbon Labs - MotionIcons for React (v12)",
  "labs": {
    "status": "draft",
    "title": "V12 motion icons",
    "entries": [
      "clock.ts"
    ]
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-labs",
    "directory": "packages/react/src/v12/components/MotionIcons"
  },
  "types": "./es/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./clock": {
      "types": "./es/clock.d.ts",
      "import": "./es/clock.js",
      "require": "./lib/clock.js"
    },
    "./es/*": "./es/*",
    "./lib/*": "./lib/*"
  },
  "files": [
    "es",
    "lib",
    "telemetry.yml"
  ],
  "scripts": {
    "build": "node ../../../../tasks/build.js",
    "clean": "rimraf es lib",
    "test": "vitest run"
  },
  "dependencies": {
    "@carbon-labs/motion-icons-core": "workspace:*",
    "@ibm/telemetry-js": "^1.10.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@carbon-labs/v12-motion": "workspace:*",
    "@carbon-labs/wc-motion-icons": "workspace:*",
    "@carbon/icons": "^11.89.0 || ^12.0.0",
    "@carbon/icons-react": "^11.90.0",
    "@carbon/react": "^1.118.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.2.2",
    "vitest": "^4.0.0"
  }
}
