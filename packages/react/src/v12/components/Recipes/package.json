{
  "name": "@carbon-labs/react-recipes",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "Carbon Labs - Recipes for React (v12)",
  "labs": {
    "status": "draft",
    "title": "V12 recipes"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-labs",
    "directory": "packages/react/src/v12/components/Recipes"
  },
  "types": "./es/index.d.ts",
  "exports": {
    ".": {
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./es/*": "./es/*",
    "./lib/*": "./lib/*",
    "./scss/*": "./scss/*"
  },
  "files": [
    "es",
    "lib",
    "scss",
    "telemetry.yml"
  ],
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "scripts": {
    "build": "node ../../../../tasks/build.js",
    "clean": "rimraf es lib scss",
    "test": "vitest run"
  },
  "dependencies": {
    "@carbon-labs/react-app-shell": "workspace:*",
    "@carbon-labs/react-chat": "workspace:*",
    "@carbon-labs/react-data-table": "workspace:*",
    "@carbon-labs/react-disclosure": "workspace:*",
    "@carbon-labs/react-feedback": "workspace:*",
    "@carbon-labs/react-kit-defaults": "workspace:*",
    "@carbon-labs/react-motion-icons": "workspace:*",
    "@carbon-labs/react-side-panel": "workspace:*",
    "@carbon-labs/react-step-flow": "workspace:*",
    "@carbon-labs/react-tearsheet": "workspace:*",
    "@carbon-labs/react-theme-zone": "workspace:*",
    "@carbon-labs/react-tooltip": "workspace:*",
    "@carbon-labs/v12-motion": "workspace:*",
    "@carbon-labs/v12-styles": "workspace:*",
    "@carbon/react": "^1.118.0",
    "@ibm/telemetry-js": "^1.10.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@carbon-labs/utilities": "0.28.0",
    "vitest": "^4.0.0"
  }
}
