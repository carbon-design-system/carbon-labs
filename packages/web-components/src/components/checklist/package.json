{
  "name": "@carbon-labs/wc-checklist",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "description": "Carbon Labs - Checklist web component",
  "labs": {
    "status": "draft",
    "title": "WC Checklist"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-labs",
    "directory": "packages/web-components/src/components/checklist"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./es/*": "./es/*",
    "./lib/*": "./lib/*"
  },
  "files": [
    "es/",
    "lib/",
    "telemetry.yml"
  ],
  "types": "./src/index.d.ts",
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "node ../../../tasks/build.js",
    "build:dist": "rm -rf dist && rollup --config ../../../tasks/build-dist.js",
    "clean": "rimraf es lib",
    "postinstall": "ibmtelemetry --config=telemetry.yml",
    "telemetry:config": "npx -y @ibm/telemetry-js-config-generator generate --id 5b40806f-86cd-48b4-b550-3f60defe53da --endpoint https://www-api.ibm.com/ibm-telemetry/v1/metrics --files ./components/**/*.(ts|tsx|js|jsx) --wc"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.2",
    "@carbon-labs/utilities": "0.28.0",
    "@carbon/web-components": "^2.41.0",
    "@ibm/telemetry-js": "^1.10.2"
  }
}
