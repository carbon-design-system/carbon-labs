  "devDependencies": {
    "@storybook/react": "^9.1.2",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^9.1.2",
    "typescript": "^5.7.2",
