{
  "name": "@carbon-labs/v12-review",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Carbon Labs - the v12 review app: every v12 component's stories, motion and props in one app, built from the components themselves",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-labs",
    "directory": "tools/v12-review"
  },
  "labs": {
    "status": "draft",
    "title": "V12 review"
  },
  "exports": {
    ".": "./src/index.ts",
