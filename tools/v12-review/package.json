    "@carbon-labs/react-motion-icons": "workspace:*",
    "@carbon-labs/react-number-input": "workspace:*",
    "@carbon-labs/react-page-header": "workspace:*",
    "@carbon-labs/react-popover": "workspace:*",
    "@carbon-labs/react-search": "workspace:*",
    "@carbon-labs/react-select": "workspace:*",
    "@carbon-labs/react-side-nav": "workspace:*",
    "@carbon-labs/react-tabs": "workspace:*",
    "@carbon-labs/react-tag": "workspace:*",
    "@carbon-labs/react-text-input": "workspace:*",
